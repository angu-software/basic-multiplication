# === Fastane settings ===
LC_ALL=en_US.UTF-8
LANG=en_US.UTF-8

FASTLANE_OPT_OUT_USAGE="YES"
FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT=10
#FASTLANE_XCODEBUILD_SETTINGS_RETRIES=2

# === Pipeline Settings ===

#APP_IDENTIFIER=
#APPLE_ID

# Pipeline output log level
# Values
# - ERROR: only errors
# IMPORTANT: currently hardcoded! Needs improvement to support multiple patterns
CD_LOG_LEVEL="ERROR"

CD_XCODE_VERSION=27.0.0
CD_XCODE_APP_NAME="Xcode-$CD_XCODE_VERSION.app"
CD_XCODE_PATH="/Applications/$CD_XCODE_APP_NAME"

CD_APP_PROJECT_ROOT="$PWD"
CD_APP_PROJECT="Basic Multiplication.xcodeproj"
CD_APP_SCHEME="One Times One"
CD_APP_NAME="OneTimesOne"

CD_ARTIFACTS_BASE_PATH="$CD_APP_PROJECT_ROOT/.cd-pipeline"
# Derived data of xcode
CD_ARTIFACTS_DERIVED_DATA_PATH="$CD_ARTIFACTS_BASE_PATH/DerivedData"
# Results of the stage run
# Contains build logs, xcresult, junit reports etc
CD_ARTIFACTS_STAGE_RESULTS_PATH="$CD_ARTIFACTS_BASE_PATH/Results"
# Artifacts produced by the state
# Contains Archives, ipa files etc
CD_ARTIFACTS_STAGE_ARTIFACTS_PATH="$CD_ARTIFACTS_BASE_PATH/Artefacts"

# S3-compatible artifact store credentials
CD_ARTIFACTS_STORE_ENDPOINT="http://192.168.188.100:9000"
CD_ARTIFACTS_STORE_ACCESS_KEY_ID="$ARTIFACTS_STORE_USER"
CD_ARTIFACTS_STORE_SECRET_ACCESS_KEY="$ARTIFACTS_STORE_PASSWORD"
# A bucket with this name must exist in minio/s3
CD_ARTIFACTS_STORE_PROJECT_ID="one-times-one"

CD_APP_BUILD_FOR_TESTING_CONFIGURATION=Debug
CD_APP_BUILD_FOR_TESTING_DEVICE="generic/platform=iOS Simulator"
CD_APP_BUILD_FOR_TESTING_CLEAN_BUILD=false
CD_APP_BUILD_FOR_TESTING_SPM_SKIP_RESOLUTION=true
CD_APP_BUILD_FOR_TESTING_SPM_SKIP_FETCHES=true
CD_APP_BUILD_FOR_TESTING_SPM_DISABLE_UPDATES=true
CD_APP_BUILD_FOR_TESTING_ADDITIONAL_XCODE_ARGS=""

# Glob pattern for artifacts to extract from CD_ARTIFACTS_DERIVED_DATA_PATH to CD_ARTIFACTS_STAGE_ARTIFACTS_PATH
# Supports multiple patterns separated by commas
# Example: "Build/Products/**/*.app,Build/Products/**/*.xctest,*.ipa,*.dSYM"
CD_ARTIFACTS_EXTRACT_PATTERN="Build/Products/**/*"

CD_APP_BUILD_FOR_TESTING_CONFIGURATION="Debug"
CD_APP_TEST_WITHOUT_BUILDING_DEVICE="platform=iOS Simulator,name=iPhone 18 Pro,OS=27.0,arch=arm64"
CD_APP_TEST_WITHOUT_BUILDING_INCLUDE_SIMULATOR_LOG=false
CD_APP_TEST_WITHOUT_BUILDING_ADDITIONAL_XCODE_ARGS=""

# Space separated list of test plan names for the development tests stage
CD_APP_DEV_TESTS_DEFAULT_TESTPLANS="UnitTests SnapshotTests AcceptanceTests"
CD_APP_COMMIT_STAGE_TESTPLANS="DevelopmentTests"
CD_APP_ACCEPTANCE_STAGE_TESTPLANS="AcceptanceTests"
